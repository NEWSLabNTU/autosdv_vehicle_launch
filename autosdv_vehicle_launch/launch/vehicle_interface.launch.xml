<?xml version="1.0" encoding="UTF-8"?>
<launch>
  <!-- Arguments -->
  <arg name="vehicle_id" default="$(env VEHICLE_ID default)"/>
  <arg name="is_simulation" default="false" description="Enable simulation mode (disables PWM output)"/>
  <arg name="launch_vehicle_interface" default="true"/>
  <arg name="actuator_log_level" default="info" description="Log level for actuator node (debug/info/warn/error/fatal)"/>
  <arg name="vehicle_info_param_file" default="$(find-pkg-share autosdv_vehicle_description)/config/vehicle_info.param.yaml"
       description="Vehicle geometry (wheel_base, wheel_tread, max_steer_angle); the file the planner uses"/>
  <!-- Speed controller plug-in. These are the only place these defaults live;
       actuator.yaml does not set them. -->
  <arg name="speed_controller_class" default="autosdv_vehicle_interface.speed_controller:AckermannSpeedPID"
       description="Inner loop, package.module:Class with reset() and update(target_speed, measured_speed, dt) -> PWM"/>
  <arg name="speed_controller_params" default=""
       description="The plug-in's own parameters as a YAML mapping string, e.g. {kp: 20.0, ki: 4.0}"/>
  <arg name="emergency_stop_on_any_mrm" default="false"
       description="true: brake on ANY operating/succeeded MRM, comfortable stop included. Needed when the planner ignores the velocity limit a comfortable stop acts through (the Lab 2 pursuit planner). false: only on an emergency-stop or failed MRM, as vehicle_cmd_gate does"/>
  <arg name="launch_signal_manager" default="true"
       description="turn indicator and hazard light status; nothing reads it in a stack without Autoware planning or the AD API vehicle adapters"/>
  <arg name="publish_operation_mode_availability" default="true"
       description="control_mode_manager also publishes /system/operation_mode/availability (always 'autonomous available'). false when the diagnostic graph converter owns that topic, so a failed graph check cannot be overwritten"/>
  <arg name="speed_controller_dt_source" default="velocity_report"
       description="dt handed to the plug-in: velocity_report (legacy; time since the last 20 Hz report, so ~3x effective ki at the 100 Hz loop) or loop (the loop period)"/>

  <!-- Vehicle Interface -->
  <group if="$(var launch_vehicle_interface)">
    <push-ros-namespace namespace="autosdv"/>

    <!-- Core vehicle interface nodes -->
    <node pkg="autosdv_vehicle_interface" exec="actuator" name="actuator_node" output="screen"
          args="--ros-args --log-level $(var actuator_log_level)">
      <param from="$(find-pkg-share autosdv_vehicle_interface)/params/actuator.yaml"/>
      <param from="$(var vehicle_info_param_file)"/>
      <!-- Override dry_run parameter based on is_simulation flag -->
      <param name="dry_run" value="$(var is_simulation)"/>
      <param name="speed_controller_class" value="$(var speed_controller_class)"/>
      <param name="speed_controller_params" value="$(var speed_controller_params)" type="str"/>
      <param name="speed_controller_dt_source" value="$(var speed_controller_dt_source)"/>
      <param name="emergency_stop_on_any_mrm" value="$(var emergency_stop_on_any_mrm)"/>
      <remap from="~/input/control_cmd" to="/control/command/control_cmd"/>
      <remap from="~/input/velocity_status" to="/vehicle/status/velocity_status"/>
      <!-- Emergency inputs: vehicle_cmd_gate's verdict and the MRM handler's state -->
      <remap from="~/input/emergency" to="/control/command/emergency_cmd"/>
      <remap from="~/input/mrm_state" to="/system/fail_safe/mrm_state"/>
    </node>

    <node pkg="autosdv_vehicle_interface" exec="velocity_report" name="velocity_report_node" output="screen">
      <param from="$(find-pkg-share autosdv_vehicle_interface)/params/velocity_report.yaml"/>
      <remap from="~/output/velocity_status" to="/vehicle/status/velocity_status"/>
    </node>

    <!-- Phase 2: Autoware Interface Compliance nodes -->

    <!-- Gear Management -->
    <!-- Uses actuator.yaml as single source of truth for motor PWM parameters -->
    <node pkg="autosdv_vehicle_interface" exec="gear_manager" name="gear_manager_node" output="screen">
      <param from="$(find-pkg-share autosdv_vehicle_interface)/params/actuator.yaml"/>
      <param from="$(find-pkg-share autosdv_vehicle_interface)/params/gear_manager.yaml"/>
    </node>

    <!-- Control Mode Management -->
    <node pkg="autosdv_vehicle_interface" exec="control_mode_manager" name="control_mode_manager_node" output="screen">
      <param from="$(find-pkg-share autosdv_vehicle_interface)/params/control_mode_manager.yaml"/>
      <param name="publish_operation_mode_availability" value="$(var publish_operation_mode_availability)"/>
    </node>

    <!-- Steering Status -->
    <!-- max_steer_angle comes from vehicle_info, the planner's own limit -->
    <node pkg="autosdv_vehicle_interface" exec="steering_status" name="steering_status_node" output="screen">
      <param from="$(var vehicle_info_param_file)"/>
      <param from="$(find-pkg-share autosdv_vehicle_interface)/params/steering_status.yaml"/>
    </node>

    <!-- Signal Management (Turn indicators and hazard lights) -->
    <node pkg="autosdv_vehicle_interface" exec="signal_manager" name="signal_manager_node" output="screen" if="$(var launch_signal_manager)">
      <param from="$(find-pkg-share autosdv_vehicle_interface)/params/signal_manager.yaml"/>
    </node>
  </group>
</launch>
